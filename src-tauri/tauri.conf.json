{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Relaxing mini-games widget",
    "longDescription": "A floating widget with a collection of relaxing mini-games. Perfect for micro-breaks during work or study.",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "productName": "ZenWidget",
  "mainBinaryName": "ZenWidget",
  "version": "0.1.0",
  "identifier": "com.zenwidget.app",
  "plugins": {},
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ZenWidget",
        "width": 360,
        "height": 316,
        "minWidth": 280,
        "minHeight": 240,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "alwaysOnTop": true,
        "transparent": true,
        "skipTaskbar": true,
        "visible": false,
        "center": false,
        "x": 40,
        "y": 40,
        "useHttpsScheme": true
      }
    ]
  }
}